\lessonlabel{2}
\section{Number Systems and Codes}

\begin{note}
\textbf{Learning outcomes.} By the end of this lesson you should be able to:
\begin{itemize}
  \item write numbers in binary, octal and hexadecimal;
  \item convert between decimal, binary, octal and hexadecimal;
  \item explain the purpose of binary coded decimal (BCD);
  \item perform simple BCD encoding and decoding;
  \item describe the excess 3 code and convert numbers to and from it.
\end{itemize}
\end{note}

\subsection{Binary system}

The \term{binary} system uses only two digits, 0 and 1. Each position represents a power of two, starting with \$2^{0}$ at the right most digit.

For example, the binary number \$1011_{2}$ equals:
\[
1\cdot2^{3}+0\cdot2^{2}+1\cdot2^{1}+1\cdot2^{0}=8+0+2+1=11_{10}.
\]

\begin{example}
Convert \$11010_{2}$ to decimal.
\[
1\cdot2^{4}+1\cdot2^{3}+0\cdot2^{2}+1\cdot2^{1}+0\cdot2^{0}=16+8+0+2+0=26_{10}.
\]
\end{example}

\subsection{Octal system}

The \term{octal} system uses digits 0--7. Each position represents a power of eight.

For example, \$157_{8}$ equals:
\[
1\cdot8^{2}+5\cdot8^{1}+7\cdot8^{0}=64+40+7=111_{10}.
\]

\begin{example}
Convert \$345_{8}$ to decimal.
\[
3\cdot8^{2}+4\cdot8^{1}+5\cdot8^{0}=192+32+5=229_{10}.
\]
\end{example}

\subsection{Hexadecimal system}

The \term{hexadecimal} system uses sixteen symbols: 0--9 and A--F (where A=10, B=11, ..., F=15). Each position represents a power of sixteen.

For example, \$2B_{16}$ equals:
\[
2\cdot16^{1}+11\cdot16^{0}=32+11=43_{10}.
\]

\begin{example}
Convert \$7C3_{16}$ to decimal.
\[
7\cdot16^{2}+12\cdot16^{1}+3\cdot16^{0}=7\cdot256+12\cdot16+3=1792+192+3=1987_{10}.
\]
\end{example}

\subsection{Conversions between bases}

\subsubsection{Decimal to binary}

Repeatedly divide the decimal number by two, recording remainders. Read the remainders upward.

\begin{example}
Convert \$19_{10}$ to binary.
\[
19/2=9\ \text{r}1,\;9/2=4\ \text{r}1,\;4/2=2\ \text{r}0,\;2/2=1\ \text{r}0,\;1/2=0\ \text{r}1.
\]
Reading upward gives \$10011_{2}$.
\end{example}

\subsubsection{Binary to octal}

Group binary digits in threes from the right; replace each group by its octal value.

\begin{example}
Convert \$1101101_{2}$ to octal.
\[
110\ 110\ 1\underline{000}\rightarrow 6\ 6\ 0_{8}=660_{8}.
\]
(Added leading zeros to make a full group of three.)
\end{example}

\subsubsection{Binary to hexadecimal}

Group binary digits in fours from the right; replace each group by its hexadecimal value.

\begin{example}
Convert \$10111011_{2}$ to hexadecimal.
\[
1011\ 1011\rightarrow B\ B_{16}=BB_{16}.
\]
\end{example}

\subsubsection{Octal or hexadecimal to binary}

Replace each octal digit by its three bit binary equivalent, or each hexadecimal digit by its four bit binary equivalent.

\begin{example}
Convert \$73_{8}$ to binary.
\[
7\rightarrow111,\;3\rightarrow011,\;\text{so }73_{8}=111011_{2}.
\]
\end{example}

\subsection{Binary coded decimal (BCD)}

\term{Binary coded decimal} stores each decimal digit separately as a four bit binary number. For example, the decimal number 47 is stored as \$0100\ 0111$ (4 = \$0100$, 7 = \$0111$).

BCD is useful in digital clocks and calculators where decimal digits must be displayed directly.

\begin{example}
Encode the decimal number 259 in BCD.
\[
2\rightarrow0010,\;5\rightarrow0101,\;9\rightarrow1001,\;\text{so }259_{10}=0010\ 0101\ 1001_{BCD}.
\]
\end{example}

\subsection{Excess 3 code}

The \term{excess 3} code is a self complementary decimal code. Each decimal digit is represented by its binary value plus three. Thus digit 0 becomes \$0011$, digit 1 becomes \$0100$, and so on up to digit 9 which becomes \$1100$.

\begin{example}
Encode the decimal number 84 in excess 3.
\[
8\rightarrow1000+3=1011,\;4\rightarrow0100+3=0111,\;\text{so }84_{10}=1011\ 0111_{Excess3}.
\]
\end{example}

\begin{keytest}
\textbf{Key test.} Convert \$101101_{2}$ to octal and hexadecimal, then encode the decimal result in BCD.
\end{keytest}

\subsection{Exercises}

\begin{enumerate}
  \item Write the decimal number 45 in binary, octal and hexadecimal.
  \item Convert \$7F_{16}$ to decimal and then to binary.
  \item Encode the decimal number 83 in BCD and decode the BCD \$1000\ 0011$ back to decimal.
  \item Encode the decimal number 62 in excess 3 and then decode \$1001\ 0101$.
  \item Perform the conversion required in the key test and check your answer.
\end{enumerate}

\subsection{Key terms}

\begin{tabular}{@{}p{3.6cm}p{10.4cm}@{}}
\toprule
\textbf{Term} & \textbf{Meaning} \\
\midrule
Binary & Base 2 number system using digits 0 and 1. \\
Octal & Base 8 number system using digits 0--7. \\
Hexadecimal & Base 16 number system using digits 0--9 and A--F. \\
Conversion & Process of changing a number from one base to another. \\
Binary coded decimal (BCD) & Representation of each decimal digit by a four bit binary code. \\
Excess 3 code & Decimal code where each digit is stored as its binary value plus three. \\
\bottomrule
\end{tabular}
